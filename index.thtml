<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>MASTER IP ULTRA</title>

<style>
body{
margin:0;
background:black;
color:lime;
font-family:monospace;
overflow-x:hidden;
}

canvas{
position:fixed;
top:0;
left:0;
z-index:-1;
}

header{
text-align:center;
padding:10px;
border-bottom:1px solid lime;
background:#111;
}

.logo{
width:100%;
}

.cyberText{
font-size:12px;
color:#00ff9c;
animation:blink 1.5s infinite;
}

@keyframes blink{
50%{opacity:0.4}
}

nav{
display:flex;
background:#111;
border-bottom:1px solid lime;
}

nav button{
flex:1;
padding:12px;
background:#111;
border:none;
color:lime;
font-weight:bold;
cursor:pointer;
}

nav button.active{
background:lime;
color:black;
}

section{
display:none;
padding:15px;
height:calc(100vh - 150px);
overflow-y:auto;
}

section.active{
display:block;
}

input,select,textarea{
width:95%;
padding:10px;
margin:8px 0;
background:#111;
color:lime;
border:1px solid lime;
}

button.action{
width:95%;
padding:12px;
background:lime;
border:none;
color:black;
font-weight:bold;
cursor:pointer;
margin-top:10px;
}

button.rainbow{
width:95%;
padding:14px;
border:none;
font-weight:bold;
cursor:pointer;
background:linear-gradient(45deg,red,orange,yellow,green,cyan,blue,purple);
color:white;
margin-top:10px;
}

.result{
margin-top:15px;
border:1px solid lime;
padding:10px;
}

.meter{
height:10px;
background:#222;
margin-top:5px;
}

.bar{
height:10px;
background:lime;
}

.terminal{
background:#000;
border:1px solid lime;
padding:10px;
font-size:12px;
margin-top:10px;
}

footer{
text-align:center;
padding:10px;
border-top:1px solid lime;
background:#111;
}

</style>
</head>

<body>

<!-- PASSWORD LOCK SCREEN -->
<div id="lockScreen"
style="position:fixed;top:0;left:0;width:100%;height:100%;background:black;color:lime;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10000;">

<h2>MASTER IP SECURITY</h2>

<input type="password" id="passInput" placeholder="Enter password">

<button class="action" onclick="openTool()">OPEN TOOL</button>

<div id="warningBox"></div>

</div>

<canvas id="matrix"></canvas>

<header>
<img src="https://files.catbox.moe/u1npgd.jpg" class="logo">
<h2>MASTER IP ULTRA</h2>
<div class="cyberText">
AI CYBER REPORT SYSTEM ACTIVE
</div>
</header>

<nav>
<button class="tab-btn active" data-tab="report">REPORT</button>
<button class="tab-btn" data-tab="unban">UNBAN</button>
<button class="tab-btn" data-tab="help">HELP</button>
<button class="tab-btn" data-tab="download">DOWNLOAD</button>
</nav>

<section id="report" class="active">
<h3>Report Account</h3>
<select id="country">
<option value="+263">Zimbabwe +263</option>
<option value="+27">South Africa +27</option>
<option value="+267">Botswana +267</option>
<option value="+44">UK +44</option>
<option value="+1">USA +1</option>
</select>
<input id="number" placeholder="Phone number">
<select id="violation">
<option value="1">Spam</option>
<option value="2">Harassment</option>
<option value="3">Threats</option>
<option value="4">Impersonation</option>
<option value="5">Scam</option>
<option value="6">Illegal Content</option>
<option value="7">Bullying</option>
</select>
<select id="frequency">
<option value="1">Once</option>
<option value="2">Multiple Times</option>
<option value="3">Daily</option>
</select>
<button class="action" onclick="analyze()">Analyze Case</button>
<div id="reportOutput" class="result"></div>
</section>

<section id="unban">
<h3>Unban Request</h3>
<input id="banNumber" placeholder="+263 number">
<select id="reasonTemplate">
<option>False report triggered ban</option>
<option>Technical system error</option>
<option>Network error during update</option>
<option>Account hacked</option>
<option>Spam detection mistake</option>
<option>Changed device recently</option>
<option>No violation committed</option>
</select>
<textarea id="banReason"></textarea>
<button class="action" onclick="generateUnban()">Generate Appeal</button>
<div id="unbanOutput" class="result"></div>
</section>

<section id="help">
<h3>System Dashboard</h3>
<div class="terminal">
Reports Generated: <span id="rCount">0</span><br>
Appeals Generated: <span id="aCount">0</span><br>
AI Scanner: ACTIVE
</div>
<button class="action" onclick="openGroup()">Join WhatsApp Group</button>
<button class="action" onclick="openChannel()">Open WhatsApp Channel</button>
</section>

<section id="download">
<h3>Download MASTER IP ULTRA APK</h3>
<button class="action" onclick="downloadAPK()">Download APK</button>
</section>

<footer>
MASTER IP ULTRA CYBER TOOL
</footer>

<script>
const OWNER_WA="263779540058";
const emails=[
"support@whatsapp.com",
"android@support.whatsapp.com",
"iphone@support.whatsapp.com",
"webclient@support.whatsapp.com"
];

/* PASSWORD LOCK */
function openTool(){
let pass=document.getElementById("passInput").value;
if(pass==="securityist404"){
document.getElementById("lockScreen").style.display="none";
}else{
document.getElementById("warningBox").innerHTML=`
<p style="color:red">Where are you going without password?</p>
<p style="color:#00ff9c">ukuendepi usina password 🔑</p>
<button class="rainbow" onclick="requestPassword()">GET PASSWORD FROM MASTER IP</button>
`;
}
}

function requestPassword(){
let message="Hello MASTER IP. I tried opening MASTER IP ULTRA but I don't have the password.";
window.open(
"https://wa.me/"+OWNER_WA+"?text="+encodeURIComponent(message),
"_blank"
);
}

/* TAB SYSTEM */
document.addEventListener("DOMContentLoaded", function(){
const tabs = document.querySelectorAll(".tab-btn");
const sections = document.querySelectorAll("section");
tabs.forEach(btn=>{
btn.addEventListener("click", function(){
tabs.forEach(b=>b.classList.remove("active"));
sections.forEach(s=>s.classList.remove("active"));
btn.classList.add("active");
const tabName = btn.getAttribute("data-tab");
document.getElementById(tabName).classList.add("active");
});
});
});

/* REPORT/UNBAN LOGIC */
let reports=0, appeals=0;

function analyze(){
let num=document.getElementById("number").value;
let strength=Math.floor(Math.random()*100);
reports++;
document.getElementById("rCount").innerText=reports;
let message="Hello WhatsApp Support,\n\nPlease review the number "+num+" for violations.";
let buttons="";
emails.forEach(mail=>{
buttons+=`
<button class="action"
onclick="sendEmail('${mail}','WhatsApp Report',\`${message}\`)">
Send to ${mail}
</button>
`;
});
document.getElementById("reportOutput").innerHTML=`
Case Strength ${strength}%
<div class="meter"><div class="bar" style="width:${strength}%"></div></div>
<div class="terminal">
[✓] scanning number<br>
[✓] checking violations<br>
[✓] preparing report<br>
[✓] ready
</div>
<textarea style="height:120px">${message}</textarea>
${buttons}
`;
}

function generateUnban(){
let num=document.getElementById("banNumber").value;
let reason=document.getElementById("reasonTemplate").value;
appeals++;
document.getElementById("aCount").innerText=appeals;
let message="Hello WhatsApp Support,\n\nMy number "+num+" was banned.\nReason: "+reason;
let buttons="";
emails.forEach(mail=>{
buttons+=`
<button class="action"
onclick="sendEmail('${mail}','WhatsApp Appeal',\`${message}\`)">
Send Appeal to ${mail}
</button>
`;
});
document.getElementById("unbanOutput").innerHTML=`
<textarea style="height:120px">${message}</textarea>
${buttons}
`;
}

function sendEmail(mail,subject,body){
let link="mailto:"+mail+"?subject="+encodeURIComponent(subject)+"&body="+encodeURIComponent(body);
window.location.href=link;
}

/* HELP BUTTONS */
function openGroup(){ window.open("https://chat.whatsapp.com/Fia1l2ttMmXKD7ZHmZUIM1"); }
function openChannel(){ window.open("https://whatsapp.com/channel/0029Vb3WyN6GehEUv1g4sS43"); }

/* DOWNLOAD APK */
function downloadAPK(){
window.location.href="https://freewebsitetoapp.cloudserverbox.com/app-data/free-apps/38972697444/GumBao8J/app-debug.apk";
}

/* MATRIX EFFECT */
var c=document.getElementById("matrix");
var ctx=c.getContext("2d");
c.height=window.innerHeight;
c.width=window.innerWidth;
var letters="MASTERIP0123456789".split("");
var font=14;
var columns=c.width/font;
var drops=[];
for(var x=0;x<columns;x++)drops[x]=1;
function draw(){
ctx.fillStyle="rgba(0,0,0,0.05)";
ctx.fillRect(0,0,c.width,c.height);
ctx.fillStyle="#0F0";
ctx.font=font+"px monospace";
for(var i=0;i<drops.length;i++){
var text=letters[Math.floor(Math.random()*letters.length)];
ctx.fillText(text,i*font,drops[i]*font);
if(drops[i]*font>c.height && Math.random()>0.975)drops[i]=0;
drops[i]++;
}}
setInterval(draw,33);

/* AD BLOCKER SIMULATION */
setInterval(()=>{
document.querySelectorAll("iframe,ins,.adsbygoogle").forEach(ad=>ad.remove());
},2000);

</script>
</body>
</html>
